{
  "name": "printvis-documentation-editor",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-based editor for PrintVis documentation",
  "scripts": {
    "dev:web": "npm --prefix apps/web run dev",
    "dev:api": "npm --prefix apps/api start",
    "build:web": "npm --prefix apps/web run build",
    "build:api": "npm --prefix apps/api run build",
    "build": "npm run build:web && npm run build:api",
    "lint:web": "npm --prefix apps/web run lint",
    "lint": "npm run lint:web"
  },
  "engines": {
    "node": ">=22 <23"
  }
}